# Copiar a `backend/.env` para desarrollo local (uvicorn sin Docker).
# Con Docker, use el `.env` en la raíz del proyecto (junto a docker-compose.yml).

GLPI_DB_HOST=127.0.0.1
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_readonly
GLPI_DB_PASSWORD=cambiar
GLPI_DB_NAME=glpidb

# Opcional: filtrar por entidad GLPI (dejar vacío = todas)
# GLPI_ENTITIES_ID=0

# Horas sin ITILFollowup público para marcar colas “estancadas”
DASHBOARD_STALE_HOURS=48

# Orígenes permitidos CORS (frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# «Rendimiento del equipo»: logins en glpi_users.name (coma). Vacío en .env = todos los técnicos.
# GLPI_COORD_PERFORMANCE_LOGINS=ejuma,DCAZA,NRIVADENEIRA,sconsultor

# Si su GLPI usa otros códigos de tipo en glpi_tickets_users (poco habitual):
# GLPI_ASSIGNEE_TYPE=2
# GLPI_REQUESTER_TYPE=1
# GLPI_STATUS_SOLVED=5
# GLPI_STATUS_CLOSED=6
# id_search_option de «Estado» en glpi_logs para detectar reabiertos (por defecto 12)
# GLPI_LOG_STATUS_SEARCH_OPTION=12

# --- PostgreSQL: indicadores de facturación (Openbravo / lectura)
# Dejar disabled si no usa este menú. Con Docker suele hacer falta host.docker.internal.
BILLING_PG_ENABLED=true
BILLING_PG_HOST=108.181.162.114
BILLING_PG_PORT=5432
BILLING_PG_USER=tad
BILLING_PG_PASSWORD=xTJ7VNwDCY9bbhPW
BILLING_PG_DATABASE=sidesoft
BILLING_PG_SCHEMA=public
