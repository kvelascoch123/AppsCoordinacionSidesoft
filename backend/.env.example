# Copiar a `backend/.env` para desarrollo local (uvicorn sin Docker).
# Con Docker, use el `.env` en la raíz del proyecto (junto a docker-compose.yml).

GLPI_DB_HOST=127.0.0.1
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_readonly
GLPI_DB_PASSWORD=cambiar
GLPI_DB_NAME=glpidb

# Opcional: filtrar por entidad GLPI (dejar vacío = todas)
# GLPI_ENTITIES_ID=0

# Horas sin ITILFollowup público para marcar colas “estancadas”
DASHBOARD_STALE_HOURS=48

# Orígenes permitidos CORS (frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# «Rendimiento del equipo»: logins en glpi_users.name (coma). Vacío en .env = todos los técnicos.
# GLPI_COORD_PERFORMANCE_LOGINS=ejuma,DCAZA,NRIVADENEIRA,sconsultor

# Si su GLPI usa otros códigos de tipo en glpi_tickets_users (poco habitual):
# GLPI_ASSIGNEE_TYPE=2
# GLPI_REQUESTER_TYPE=1
# GLPI_STATUS_SOLVED=5
# GLPI_STATUS_CLOSED=6
# id_search_option de «Estado» en glpi_logs para detectar reabiertos (por defecto 12)
# GLPI_LOG_STATUS_SEARCH_OPTION=12

# id_search_option del técnico asignado en glpi_logs (carga entrante por semana ISO). 0 = desactivar. Pruebe 5 si GLPI no registra asignaciones.
# GLPI_LOG_ASSIGNEE_TECH_SEARCH_OPTION=5

# --- PostgreSQL: indicadores de facturación (Openbravo / lectura)
# Dejar disabled si no usa este menú. Con Docker suele hacer falta host.docker.internal.
# BILLING_PG_ENABLED=true
# BILLING_PG_HOST=host.docker.internal
# BILLING_PG_PORT=5432
# BILLING_PG_USER=readonly
# BILLING_PG_PASSWORD=cambiar
# BILLING_PG_DATABASE=idempiere
# BILLING_PG_SCHEMA=public

# --- Autenticación (usuarios de GLPI) y Configuraciones del sistema ---
# Obligatorios. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No cambie DASHBOARD_ENCRYPTION_KEY después de guardar la contraseña SMTP (dejaría de poder descifrarse).
DASHBOARD_SESSION_SECRET=
DASHBOARD_ENCRYPTION_KEY=
# Perfiles GLPI (glpi_profiles.name) que pueden ingresar / que ven «Configuraciones del sistema»
# DASHBOARD_ALLOWED_PROFILES=Super-Admin,Admin,Supervisor,Technician
# DASHBOARD_ADMIN_PROFILES=Super-Admin
# false = panel abierto sin login (Configuraciones del sistema queda accesible para todos)
# DASHBOARD_AUTH_ENABLED=true
# Solo estos logins GLPI pueden ingresar (vacío = por perfiles)
# DASHBOARD_ALLOWED_LOGINS=kvelasco
# Duración de la sesión en horas; se renueva sola con el uso (180 días)
# DASHBOARD_SESSION_HOURS=4320
# true si el panel se publica por HTTPS
# DASHBOARD_COOKIE_SECURE=false
