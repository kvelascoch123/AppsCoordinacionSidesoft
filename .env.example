# Copiar a `.env` en esta misma carpeta (ra�z del proyecto, junto a docker-compose.yml).

# --- Conexi�n MySQL / MariaDB de GLPI (desde el contenedor) ---
# En Windows/Mac: MySQL en el PC anfitri�n suele ser:
GLPI_DB_HOST=host.docker.internal
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_readonly
GLPI_DB_PASSWORD=cambiar
GLPI_DB_NAME=glpidb

# Opcional
# GLPI_ENTITIES_ID=0
DASHBOARD_STALE_HOURS=48

# Or�genes CORS (si accede al API sin pasar por Nginx)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# Puerto publicado del panel (Nginx)
# WEB_PORT=8080

# An�lisis con IA (OpenAI)  obligatorio para botones de an�lisis de ticket y men� An�lisis
OPENAI_API_KEY=tu_api_key_aqui

# --- Autenticación (usuarios de GLPI) y Configuraciones del sistema ---
# Obligatorios. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No cambie DASHBOARD_ENCRYPTION_KEY después de guardar la contraseña SMTP (dejaría de poder descifrarse).
DASHBOARD_SESSION_SECRET=
DASHBOARD_ENCRYPTION_KEY=
# Perfiles GLPI (glpi_profiles.name) que pueden ingresar / que ven «Configuraciones del sistema»
# DASHBOARD_ALLOWED_PROFILES=Super-Admin,Admin,Supervisor,Technician
# DASHBOARD_ADMIN_PROFILES=Super-Admin
# false = panel abierto sin login (Configuraciones del sistema queda accesible para todos)
# DASHBOARD_AUTH_ENABLED=true
# Solo estos logins GLPI pueden ingresar (vacío = por perfiles)
# DASHBOARD_ALLOWED_LOGINS=kvelasco
# Duración de la sesión en horas; se renueva sola con el uso (180 días)
# DASHBOARD_SESSION_HOURS=4320
# true si el panel se publica por HTTPS
# DASHBOARD_COOKIE_SECURE=false
