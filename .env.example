# Copiar a `.env` en esta misma carpeta (raíz del proyecto, junto a docker-compose.yml).

# --- Conexión MySQL / MariaDB de GLPI (desde el contenedor) ---
# En Windows/Mac: MySQL en el PC anfitrión suele ser:
GLPI_DB_HOST=host.docker.internal
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_readonly
GLPI_DB_PASSWORD=cambiar
GLPI_DB_NAME=glpidb

# Opcional
# GLPI_ENTITIES_ID=0
DASHBOARD_STALE_HOURS=48

# Orígenes CORS (si accede al API sin pasar por Nginx)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# Puerto publicado del panel (Nginx)
# WEB_PORT=8080

# Análisis con IA (OpenAI)  obligatorio para botones de análisis de ticket y menú Análisis
OPENAI_API_KEY=tu_api_key_aqui
