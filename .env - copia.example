# Copiar a `.env` en esta misma carpeta (ra�z del proyecto, junto a docker-compose.yml).

# --- Conexi�n MySQL / MariaDB de GLPI (desde el contenedor) ---
# En Windows/Mac: MySQL en el PC anfitri�n suele ser:
GLPI_DB_HOST=host.docker.internal
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_readonly
